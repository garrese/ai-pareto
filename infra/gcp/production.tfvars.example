project_id         = "ia-models-analyzer"
region             = "europe-west1"
firestore_location = "europe-west1"

# The bucket defaults to a project-derived globally unique name. The branded
# Hosting site is kept separate from the permanent project-ID site.
public_data_bucket_name = null
firebase_site_id        = "ai-pareto"

# Set this locally to enable a billing-account budget. It is not a secret.
billing_account_id   = null
monthly_budget_units = 10
budget_currency      = "EUR"

# Leave null for the first apply. After Cloud Build finishes, set the immutable
# Artifact Registry URL ending in @sha256:<digest> and apply again.
collector_image = null

# Leave both null until the X developer App and user token are ready. Then set
# the digest-pinned publisher image and the numeric authenticated user ID.
publisher_image = null
x_user_id       = null
public_site_url = "https://ai-pareto.web.app"
